      "studyDate": {
        "type": "string",
        "format": "date"
      },
      "bom": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/BOMLine"
        },
        "minItems": 1,
        "maxItems": 100
      }
    },
    "required": [
      "name",
      "functionalUnit",
      "outputQuantity",
      "boundary",
      "studyDate",
      "bom"
    ]
  },
  "Insights": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "periodId": {
        "type": "string",
        "format": "uuid"
      },
      "questionId": {
        "type": "string",
        "enum": [
          "EMISSIONS_SUMMARY",
          "MISSING_SUBMISSIONS",
          "TOP_HOTSPOTS",
          "EVIDENCE_GAPS",
          "SCOPE3_COVERAGE"
        ]
      }
    },
    "required": [
      "periodId",
      "questionId"
    ]
  },
  "Commuting": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "oneWayKm": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d{1,6})?$",
        "description": "Exact decimal string; scientific notation and JSON numbers are rejected."
      },
      "days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 366
      },
      "participants": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "mode": {
        "type": "string",
        "minLength": 1
      },
      "basis": {
        "type": "string",
        "enum": [
          "passenger_km",
          "vehicle_km"
        ]
      },
      "occupancy": {
        "type": "string",
        "pattern": "^\\d+(\\.\\d{1,6})?$",
        "description": "Exact decimal string; scientific notation and JSON numbers are rejected."
      },
      "sampleSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "population": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
      },
      "extrapolate": {
        "type": "boolean"
      }
    },
    "required": [
      "oneWayKm",
      "days",
      "participants",
      "mode",
      "basis",
      "sampleSize",
      "population",
      "extrapolate"
    ]
  },
  "SupplierResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "answers": {
        "type": "object",
        "description": "Keys must match the invitation questions. NUMBER answers are decimal strings."
      },
      "attestation": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "version",
      "answers",
      "attestation"
    ]
  },
  "Score": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "topic": {
        "type": "string",
        "minLength": 1
      },
      "impact": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "financial": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "rationale": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "topic",
      "impact",
      "financial"
    ]
  },
  "SurveyResponse": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "scores": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Score"
        },
        "minItems": 1,
        "maxItems": 30
      },
      "consent": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "version",
      "scores",
      "consent"
    ]
  }
}
