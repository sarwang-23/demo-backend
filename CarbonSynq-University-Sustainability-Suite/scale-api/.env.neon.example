# CarbonSynq: Neon database + LOCAL Docker storage/scanner, port 5000.
# NOT production. This file contains placeholders only, no valid cloud/API credentials.
# 1. Rotate every credential previously shared in chat.
# 2. Replace the ENTIRE DATABASE_OWNER_URL below with the newly rotated Neon URL.
#    Use a separate DEMO branch/database. Confirm the hostname in the Neon Console.
# 3. Run npm run env:prepare, then npm run env:check, then npm run neon:up.
#    The helper creates random local secrets and dedicated-role URLs on YOUR machine.
#    It does not connect to Neon, create roles, or change any database.
# Never commit or share the prepared .env. Do not use the old compose.yaml with this file.
CARBONSYNQ_ENV_PROFILE=neon-local
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5000

# Owner is used ONLY by operator migrations/provisioning, not API or worker containers.
# A pooled URL copied here is converted to a direct Neon URL by env:prepare.
DATABASE_OWNER_URL="postgresql://neondb_owner:REPLACE_WITH_ROTATED_PASSWORD@ep-patient-night-azvrkaf6.c-3.ap-southeast-1.aws.neon.tech/neondb"
DATABASE_URL=GENERATE_ON_YOUR_MACHINE
WORKER_DATABASE_URL=GENERATE_ON_YOUR_MACHINE
DB_API_PASSWORD=GENERATE_ON_YOUR_MACHINE
DB_WORKER_PASSWORD=GENERATE_ON_YOUR_MACHINE
DB_SSL=true
# pg enables SCRAM channel binding when offered; this is NOT libpq require semantics.
DB_CHANNEL_BINDING=true
DB_POOL_MAX=5
# Direct runtime endpoints deliberately retain existing per-connection timeout behavior.
# No URL sslmode/sslcert/sslkey/sslrootcert parameters after preparation.
# Optional managed CA bundle (host mode only; mount it explicitly for containers):
# DB_CA_FILE=/absolute/path/to/ca.pem

# Local private versioned object storage. NOT your Neon DB password or a cloud AWS key.
S3_BUCKET=carbonsynq-evidence
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
# AWS_REGION belongs to local object storage; it is independent of Neon database geography.
AWS_ACCESS_KEY_ID=cs-local-only
AWS_SECRET_ACCESS_KEY=GENERATE_ON_YOUR_MACHINE
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
METRICS_TOKEN=GENERATE_ON_YOUR_MACHINE
REQUEST_HASH_SECRET=GENERATE_ON_YOUR_MACHINE
MAX_UPLOAD_BYTES=10485760
MAX_INFLIGHT_UPLOADS=4
MAX_INFLIGHT_REQUESTS=64
WORKER_POLL_MS=1000
JOB_LEASE_SECONDS=180
SCAN_TIMEOUT_MS=45000
SESSION_HOURS=8
TRUST_PROXY=false

# Capture mode DOES NOT send email. The worker's local capture is temporary.
MAIL_MODE=capture
MAIL_ENCRYPTION_KEY=GENERATE_ON_YOUR_MACHINE
MAIL_CAPTURE_DIR=.private-mail
OCR_ENABLED=true
# English OCR needs the scanner worker + Tesseract/Poppler included in Dockerfile.
# JWT_SECRET and Gemini/Affinda/Mistral/Climatiq keys are NOT used by scale-api.

# Used only by an explicit fresh-tenant provisioning command. Not existing-tenant updates.
TENANT_NAME="University Demo"
ADMIN_EMAIL=admin@university.example
REVIEWER_EMAIL=reviewer@university.example
# No prefilled ADMIN_PASSWORD or REVIEWER_PASSWORD: provisioning generates fresh values.
